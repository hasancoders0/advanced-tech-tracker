"use client";

import { useMemo, useState } from "react";
import {
  DollarSign,
  ShoppingCart,
  Timer,
  AlertTriangle,
} from "lucide-react";

import PageHeader from "@/components/common/PageHeader";
import TrendRangeTabs from "@/components/trend/TrendRangeTabs";
import TrendViewSwitcher from "@/components/trend/TrendViewSwitcher";
import TrendPeriodNavigator from "@/components/trend/TrendPeriodNavigator";
import TrendMetricCard from "@/components/trend/TrendMetricCard";
import TrendChartView from "@/components/trend/TrendChartView";

import salesData from "@/data/sales/sales-daily";

import {
  addDays,
  subDays,
} from "date-fns";

import {
  formatDisplayDate,
  getLatestDataDate,
  getRecordDate,
  toDate,
  getWeekStart,
} from "@/components/trend/trend-utils";

function getSaleTotal(sale) {
  return Number(
    sale?.total ??
    sale?.totalAmount ??
    sale?.grandTotal ??
    sale?.amount ??
    sale?.revenue ??
    0
  );
}

function getPaymentStatus(sale) {
  return String(
    sale?.paymentStatus ??
    sale?.status ??
    ""
  ).toLowerCase();
}

export default function SalesTrendPage() {
  const latestDate = useMemo(
    () => getLatestDataDate(salesData),
    []
  );

  const [range, setRange] = useState("week");
  const [view, setView] = useState("list");
  const [selectedDate, setSelectedDate] = useState(latestDate);

  const weekStart = getWeekStart(selectedDate);

  const weekDates = useMemo(() => {
    return Array.from({ length: 5 }, (_, index) =>
      addDays(weekStart, index)
    );
  }, [weekStart]);

  const salesInPeriod = useMemo(() => {
    return salesData.filter((sale) => {
      const rawDate = getRecordDate(sale);

      if (!rawDate) return false;

      const date = toDate(rawDate);

      if (!date) return false;

      const start = weekDates[0];
      const end = weekDates[weekDates.length - 1];

      return date >= start && date <= end;
    });
  }, [weekDates]);

  const summary = useMemo(() => {
    const count = salesInPeriod.length;

    const revenue = salesInPeriod.reduce(
      (total, sale) => total + getSaleTotal(sale),
      0
    );

    const pending = salesInPeriod.filter((sale) => {
      const status = getPaymentStatus(sale);

      return [
        "pending",
        "unpaid",
        "partial",
        "partially paid",
      ].includes(status);
    }).length;

    return {
      count,
      revenue,
      average: count ? revenue / count : 0,
      pending,
    };
  }, [salesInPeriod]);

  const chartData = useMemo(() => {
    return weekDates.map((date) => {
      const dayKey = date.toISOString().slice(0, 10);

      const daySales = salesData.filter((sale) => {
        const rawDate = getRecordDate(sale);

        return rawDate === dayKey;
      });

      const revenue = daySales.reduce(
        (total, sale) => total + getSaleTotal(sale),
        0
      );

      return {
        label: formatDisplayDate(date),
        revenue,
      };
    });
  }, [weekDates]);

  function moveWeek(direction) {
    setSelectedDate(
      direction === "next"
        ? addDays(weekStart, 7)
        : subDays(weekStart, 7)
    );
  }

  function goLatest() {
    setSelectedDate(latestDate);
  }

  const periodLabel = `${formatDisplayDate(
    weekDates[0]
  )} - ${formatDisplayDate(
    weekDates[weekDates.length - 1]
  )}`;

  return (
    <div className="space-y-5">
      <PageHeader
        title="Sales Trend"
        description="Review historical sales performance from daily sales records."
      />

      <div className="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
        <TrendRangeTabs
          value={range}
          onChange={setRange}
          module="sales"
        />

        <TrendViewSwitcher
          value={view}
          onChange={setView}
        />
      </div>

      <TrendPeriodNavigator
        label={range === "week" ? "Week Of" : "Selected Period"}
        periodLabel={periodLabel}
        onPrevious={() => moveWeek("previous")}
        onNext={() => moveWeek("next")}
        onToday={goLatest}
      />

      <div className="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4">
        <TrendMetricCard
          label="Sales"
          value={summary.count}
          description="Sales in selected period"
          icon={ShoppingCart}
        />

        <TrendMetricCard
          label="Revenue"
          value={`$${summary.revenue.toFixed(2)}`}
          description="Total revenue"
          icon={DollarSign}
        />

        <TrendMetricCard
          label="Average Sale"
          value={`$${summary.average.toFixed(2)}`}
          description="Average sale value"
          icon={Timer}
        />

        <TrendMetricCard
          label="Pending"
          value={summary.pending}
          description="Pending payments"
          icon={AlertTriangle}
          danger={summary.pending > 0}
        />
      </div>

      {view === "list" ? (
        <div className="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <div className="mb-5">
            <h2 className="text-sm font-semibold text-slate-800">
              Sales Summary
            </h2>

            <p className="mt-1 text-xs text-slate-400">
              {salesInPeriod.length} sales recorded during this period.
            </p>
          </div>

          <div className="grid grid-cols-1 gap-4 md:grid-cols-5">
            {chartData.map((item) => (
              <div
                key={item.label}
                className="rounded-lg border border-slate-100 bg-slate-50 p-4"
              >
                <p className="text-xs font-medium text-slate-400">
                  {item.label}
                </p>

                <p className="mt-2 text-lg font-semibold text-slate-800">
                  ${item.revenue.toFixed(2)}
                </p>
              </div>
            ))}
          </div>
        </div>
      ) : (
        <TrendChartView
          view={view}
          data={chartData}
          xKey="label"
          series={[
            {
              dataKey: "revenue",
              label: "Revenue",
            },
          ]}
          title="Sales Revenue Trend"
          description="Daily sales revenue calculated from sales records."
        />
      )}
    </div>
  );
}
