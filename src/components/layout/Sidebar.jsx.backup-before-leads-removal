        href: "/workforce/employees",
        icon: Users,
      },
      {
        label: "Departments",
        href: "/workforce/departments",
        icon: Settings,
      },
    ],
  },

  {
    key: "sales",
    label: "Sales",
    icon: ShoppingCart,
    children: [
      {
        label: "Today's Sales",
        href: "/sales/today",
        icon: ClipboardList,
      },
      {
        label: "Customers",
        href: "/sales/customers",
        icon: Users,
      },
      {
        label: "Products & Services",
        href: "/sales/products",
        icon: Package,
      },
      {
        label: "Leads",
        href: "/sales/leads",
        icon: Users,
      },
    ],
  },

  {
    key: "trend",
    label: "Trend",
    icon: BarChart3,
    children: [
      {
        label: "Week",
        href: "/trend/week",
      },
      {
        label: "MTD",
